{
  "name": "simple",
  "version": "0.0.0",
  "description": "Simple Template",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:js && pnpm build:dts",
    "build:js": "esbuild src/index.ts --bundle --packages=external --minify --format=cjs --outfile=dist/index.cjs && esbuild src/index.ts --bundle --packages=external --minify --format=esm --outfile=dist/index.js",
    "build:dts": "dts-bundle-generator -o dist/index.d.ts src/index.ts --no-check",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "foo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "peerDependencies": {
    "@geajs/core": "^1.5.1",
    "@geastack-community/utils": "^0.1.0"
  },
  "devDependencies": {
    "@geajs/core": "^1.5.1",
    "@geastack-community/utils": "^0.1.0"
  }
}